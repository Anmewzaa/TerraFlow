{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "cwd": "web"
    },
    {
      "name": "web-8081",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set TF_API_TARGET=http://localhost:8081&& npx vite --port 5174"
      ],
      "port": 5174,
      "cwd": "web"
    },
    {
      "name": "web-k8s",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set TF_API_TARGET=http://localhost:18080&& npx vite --port 5180 --strictPort"
      ],
      "port": 5180,
      "cwd": "web"
    }
  ]
}