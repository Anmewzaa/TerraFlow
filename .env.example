# TerraFlow settings. Copy to .env.local and fill in what you need.
#
#   - .env.local and .env are ignored by git. NEVER commit real values.
#   - The server reads .env.local, then .env, from the folder you start it in.
#     A real environment variable always wins over the file.
#   - Write values as NAME=value. Quote a value that has spaces. Backslashes are
#     kept as written, but forward slashes (C:/Users/me/key.pem) are the safer
#     choice on Windows.
#   - Never put a private key or secret in chat, in an issue, or in a screenshot.

# --- Server -----------------------------------------------------------------
# TF_ADDR=:8080
# TF_WORKSPACE_DIR=./workspace          # local provider only (development)
# TF_SAMPLE_DIR=./samples/iac/AIC
# TF_CATALOG_DIR=./catalog/modules

# --- Database (local Postgres; `make db` starts one with docker compose) ----
TF_PG_HOST=localhost
TF_PG_PORT=5432
TF_PG_DATABASE=terraflow
TF_PG_USER=terraflow
TF_PG_PASSWORD=localdev
# TF_NO_DB=true                         # run without a database (limited)

# --- Local development sign-in (made-up users) ------------------------------
# Never together with the Entra settings below: the server refuses to start.
TF_AUTH_DISABLED=true
TF_DEV_LOGIN=true
TF_SEED=true
TF_INSECURE_COOKIES=true                # plain HTTP on localhost only
# TF_SEPARATION_OF_DUTIES=true

# --- Real Entra sign-in (leave commented while TF_AUTH_DISABLED=true) --------
# TF_ENTRA_TENANT_ID=
# TF_ENTRA_CLIENT_ID=
# TF_ENTRA_CLIENT_SECRET=
# TF_ENTRA_REDIRECT_URI=http://localhost:8080/auth/callback
# TF_ENTRA_DEVOPS_GROUP_ID=
# TF_ENTRA_DEV_GROUP_ID=

# --- Browser access ----------------------------------------------------------
# Only if the UI is served from another origin than the API (comma separated).
# TF_ALLOWED_ORIGINS=http://localhost:5173

# --- GitHub (Phase 8, D-049, D-050) -------------------------------------------
# GitHub App (milestone M1; read by the server since 8.1). Created by the owner on GitHub (any account, callback URL
# on localhost). The private key stays in a file outside the repository, or as base64 in
# the host's secret store. The same App provides sign-in with GitHub (milestone M2).
# TF_GITHUB_APP_ID=
# TF_GITHUB_APP_SLUG=
# TF_GITHUB_APP_CLIENT_ID=
# TF_GITHUB_APP_CLIENT_SECRET=
# TF_GITHUB_APP_PRIVATE_KEY_FILE=C:/Users/you/.terraflow/github-app.pem
# TF_GITHUB_APP_PRIVATE_KEY_B64=        # alternative to the file
# TF_GITHUB_ALLOWED_OWNERS=             # accounts that may install the App; empty = any
# TF_GITHUB_REDIRECT_URI=http://localhost:8080/api/github/callback   # the callback URL set on the App
# TF_WEB_URL=http://localhost:5173      # where the screens are served, when not by this server
# TF_MIGRATE_ON_START=false             # run `terraflow migrate` as a separate step instead

# Sign-in providers to show on the login page (milestone M2): github, entra.
# TF_LOGIN_PROVIDERS=github,entra

# Global admins (milestone M2): GitHub or Entra ids or emails, comma separated.
# TF_ADMIN_USERS=

# Who may use TerraFlow (milestone M2): approval (default; a new user waits for an admin),
# open, or invite_only.
# TF_SIGNUP_MODE=approval
# Optional auto-approval rules, comma separated, e.g. entra-tenant, github-org:myorg,
# email-domain:example.com
# TF_AUTO_APPROVE=

# One database URL with sslmode (replaces TF_PG_* when set).
# TF_DATABASE_URL=

# --- Tests ---------------------------------------------------------------------
# A Postgres where the tests may create and drop databases. Without it the store
# and API Postgres tests are skipped.
# TF_TEST_PG_DSN=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
