{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Azure NSG with security rules and subnet associations.",
  "properties": {
    "name": {
      "description": "(Required) Specifies the name of the network security group. Changing this forces a new resource to be created.",
      "title": "NSG Name",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "resource_group_name": {
      "description": "(Required) The name of the resource group in which to create the network security group. Changing this forces a new resource to be created.",
      "title": "Resource Group",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 2,
        "pick": {
          "module_type": "resource-group",
          "output": "name"
        },
        "widget": "pick-existing"
      }
    },
    "security_rules": {
      "description": "List of security_rule",
      "items": {
        "properties": {
          "access": {
            "type": "string"
          },
          "destination_address_prefix": {
            "type": "string"
          },
          "destination_port_range": {
            "type": "string"
          },
          "direction": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "priority": {
            "type": "number"
          },
          "protocol": {
            "type": "string"
          },
          "source_address_prefix": {
            "type": "string"
          },
          "source_port_range": {
            "type": "string"
          }
        },
        "required": [
          "access",
          "destination_address_prefix",
          "destination_port_range",
          "direction",
          "name",
          "priority",
          "protocol",
          "source_address_prefix",
          "source_port_range"
        ],
        "type": "object"
      },
      "title": "Security Rules",
      "type": "array",
      "x-tf-ui": {
        "group": "rules",
        "order": 1,
        "widget": "list-of-objects"
      }
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "(Optional) A mapping of tags to assign to the resource.",
      "title": "Tags",
      "type": "object",
      "x-tf-ui": {
        "group": "tags",
        "order": 1,
        "widget": "key-value-map"
      }
    }
  },
  "required": [
    "name",
    "resource_group_name",
    "security_rules"
  ],
  "title": "Network Security Group",
  "type": "object",
  "x-tf-canvas": {
    "domain": "network",
    "parents": [
      "resource-group"
    ]
  },
  "x-tf-link": {
    "offers": [
      {
        "kind": "network_security_group",
        "output": "id"
      }
    ]
  },
  "x-tf-module": {
    "filename": "nsg.tf",
    "icon": "NetworkSecurityGroup",
    "provider": "azurerm",
    "source": "git::https://github.com/Anmewzaa/infrastructure-terraform-modules.git//modules/azure/network_security_group",
    "target_folder": "vnet",
    "version": "v1"
  },
  "x-tf-ui": {
    "groups": [
      {
        "id": "basics",
        "label": "Basics",
        "order": 1
      },
      {
        "id": "rules",
        "label": "Security Rules",
        "order": 2
      },
      {
        "id": "associations",
        "label": "Subnet Associations",
        "order": 3
      },
      {
        "id": "tags",
        "label": "Tags",
        "order": 4
      }
    ]
  }
}
