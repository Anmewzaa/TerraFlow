{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private DNS Zone",
  "description": "Private DNS zone, optionally linked to virtual networks.",
  "type": "object",
  "x-tf-module": {
    "source": "private-dns-zone",
    "version": "v1",
    "target_folder": "vnet",
    "filename": "dns.tf",
    "icon": "PrivateDnsZone"
  },
  "x-tf-canvas": {
    "parents": [
      "resource-group"
    ],
    "domain": "network"
  },
  "x-tf-ui": {
    "groups": [
      {
        "id": "basics",
        "label": "Basics",
        "order": 1
      },
      {
        "id": "tags",
        "label": "Tags",
        "order": 2
      }
    ]
  },
  "required": [
    "name",
    "resource_group_name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "title": "Zone Name",
      "description": "e.g. privatelink.blob.core.windows.net.",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "resource_group_name": {
      "type": "string",
      "title": "Resource Group",
      "x-tf-ui": {
        "group": "basics",
        "order": 2,
        "widget": "pick-existing",
        "pick": {
          "module_type": "resource-group",
          "output": "name"
        }
      }
    },
    "virtual_network_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Linked VNet IDs",
      "default": [],
      "x-tf-ui": {
        "group": "basics",
        "order": 3,
        "widget": "list-of-strings"
      }
    },
    "tags": {
      "type": "object",
      "title": "Tags",
      "default": {},
      "additionalProperties": {
        "type": "string"
      },
      "x-tf-ui": {
        "group": "tags",
        "order": 1,
        "widget": "key-value-map"
      }
    }
  }
}
