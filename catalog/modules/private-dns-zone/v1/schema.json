{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Private DNS zone, optionally linked to virtual networks.",
  "properties": {
    "name": {
      "description": "(Required) The name of the Private DNS Zone. Must be a valid domain name. Changing this forces a new resource to be created.",
      "title": "Zone Name",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "resource_group_name": {
      "description": "(Required) Specifies the resource group where the resource exists. Changing this forces a new resource to be created.",
      "title": "Resource Group",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 2,
        "pick": {
          "module_type": "resource-group",
          "output": "name"
        },
        "widget": "pick-existing"
      }
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "(Optional) A mapping of tags to assign to the resource.",
      "title": "Tags",
      "type": "object",
      "x-tf-ui": {
        "group": "tags",
        "order": 1,
        "widget": "key-value-map"
      }
    }
  },
  "required": [
    "name",
    "resource_group_name"
  ],
  "title": "Private DNS Zone",
  "type": "object",
  "x-tf-canvas": {
    "domain": "network",
    "parents": [
      "resource-group"
    ]
  },
  "x-tf-link": {
    "offers": [
      {
        "kind": "private_dns_zone",
        "output": "id"
      }
    ]
  },
  "x-tf-module": {
    "filename": "dns.tf",
    "icon": "PrivateDnsZone",
    "provider": "azurerm",
    "source": "git::https://github.com/Anmewzaa/infrastructure-terraform-modules.git//modules/azure/private_dns_zone",
    "target_folder": "vnet",
    "version": "v1"
  },
  "x-tf-ui": {
    "groups": [
      {
        "id": "basics",
        "label": "Basics",
        "order": 1
      },
      {
        "id": "tags",
        "label": "Tags",
        "order": 2
      }
    ]
  }
}
