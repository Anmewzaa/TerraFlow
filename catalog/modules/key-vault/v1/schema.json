{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Key Vault",
  "description": "Azure Key Vault with optional private endpoint.",
  "type": "object",
  "x-tf-module": {
    "source": "git::https://github.com/Anmewzaa/infrastructure-terraform-modules.git//modules/key-vault",
    "version": "v1",
    "target_folder": "keyvault",
    "filename": "kv.tf",
    "icon": "KeyVault"
  },
  "x-tf-link": {
    "offers": [
      { "kind": "private_link", "output": "id", "subresource": "vault" }
    ]
  },
  "x-tf-canvas": {"parents": ["resource-group"], "domain": "security"},
  "x-tf-ui": {
    "groups": [
      { "id": "basics", "label": "Basics", "order": 1 },
      { "id": "security", "label": "Security", "order": 2 },
      { "id": "networking", "label": "Networking", "order": 3 },
      { "id": "tags", "label": "Tags", "order": 4 }
    ]
  },
  "required": ["name", "resource_group_name", "location", "tenant_id"],
  "properties": {
    "name": {
      "type": "string",
      "title": "Key Vault Name",
      "description": "Globally unique, 3-24 chars.",
      "pattern": "^[a-zA-Z][a-zA-Z0-9-]{1,22}[a-zA-Z0-9]$",
      "x-tf-ui": { "group": "basics", "order": 1 }
    },
    "resource_group_name": {
      "type": "string",
      "title": "Resource Group",
      "x-tf-ui": {
        "group": "basics",
        "order": 2,
        "widget": "pick-existing",
        "pick": { "module_type": "resource-group", "output": "name" }
      }
    },
    "location": {
      "type": "string",
      "title": "Location",
      "x-tf-ui": {
        "group": "basics",
        "order": 3,
        "widget": "pick-existing",
        "pick": { "module_type": "resource-group", "output": "location" }
      }
    },
    "tenant_id": {
      "type": "string",
      "title": "Tenant ID",
      "x-tf-ui": { "group": "basics", "order": 4, "widget": "derived", "hidden": true }
    },
    "sku_name": {
      "type": "string",
      "title": "SKU",
      "default": "standard",
      "enum": ["standard", "premium"],
      "x-tf-ui": { "group": "basics", "order": 5 }
    },
    "soft_delete_retention_days": {
      "type": "integer",
      "title": "Soft Delete Retention (days)",
      "default": 90,
      "minimum": 7,
      "maximum": 90,
      "x-tf-ui": { "group": "security", "order": 1 }
    },
    "purge_protection_enabled": {
      "type": "boolean",
      "title": "Purge Protection",
      "default": true,
      "x-tf-ui": { "group": "security", "order": 2 }
    },
    "public_network_access_enabled": {
      "type": "boolean",
      "title": "Public Network Access",
      "default": false,
      "x-tf-ui": {
        "group": "networking",
        "order": 1,
        "widget": "locked",
        "locked_reason": "Bank policy requires false"
      }
    },
    "private_endpoint": {
      "type": ["object", "null"],
      "title": "Private Endpoint",
      "default": null,
      "x-tf-ui": { "group": "networking", "order": 2, "widget": "nullable-object" },
      "properties": {
        "subnet_id": {
          "type": "string",
          "title": "Subnet",
          "x-tf-ui": {
            "widget": "pick-existing",
            "pick": { "module_type": "virtual-network", "output": "subnet_ids" }
          }
        },
        "private_dns_zone_ids": {
          "type": "array",
          "items": { "type": "string" },
          "title": "Private DNS Zone IDs"
        }
      },
      "required": ["subnet_id", "private_dns_zone_ids"]
    },
    "tags": {
      "type": "object",
      "title": "Tags",
      "default": {},
      "additionalProperties": { "type": "string" },
      "x-tf-ui": { "group": "tags", "order": 1, "widget": "key-value-map" }
    }
  }
}
