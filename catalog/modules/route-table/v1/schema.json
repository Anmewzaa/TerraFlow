      "title": "Name",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "resource_group_name": {
      "description": "(Required) The name of the resource group in which to create the route table. Changing this forces a new resource to be created.",
      "title": "Resource group name",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
