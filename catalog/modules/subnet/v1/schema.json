{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subnet",
  "description": "A subnet inside a virtual network. Becomes an entry of the VNet module's subnets input.",
  "type": "object",
  "x-tf-module": {
    "source": "git::https://github.com/Anmewzaa/infrastructure-terraform-modules.git//modules/subnet",
    "version": "v1",
    "target_folder": "vnet",
    "icon": "Subnet"
  },
  "x-tf-link": {
    "offers": [
      {
        "kind": "subnet",
        "output": "subnet_ids[\"{name}\"]",
        "via_parent": true
      }
    ]
  },
  "x-tf-canvas": {
    "container": true,
    "parents": [
      "virtual-network"
    ],
    "parent_required": true,
    "nest": {
      "field": "subnets"
    },
    "domain": "network"
  },
  "x-tf-ui": {
    "groups": [
      {
        "id": "basics",
        "label": "Basics",
        "order": 1
      },
      {
        "id": "networking",
        "label": "Networking",
        "order": 2
      }
    ]
  },
  "required": [
    "name",
    "address_prefixes"
  ],
  "properties": {
    "name": {
      "type": "string",
      "title": "Subnet Name",
      "description": "1 to 80 letters, digits, . _ - (Azure rules). Convention: snet-<purpose>; a project can require it under Settings > Checks.",
      "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]{0,78}[A-Za-z0-9_])?$",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "address_prefixes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Address Prefixes",
      "description": "CIDR blocks inside the virtual network, e.g. 10.0.1.0/24. Use the helper below to pick a free block.",
      "x-tf-ui": {
        "group": "networking",
        "order": 1,
        "widget": "cidr-list",
        "cidr": {
          "parent_field": "address_space",
          "suggest": [
            24,
            26,
            27,
            28
          ]
        }
      }
    },
    "service_endpoints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Service Endpoints",
      "default": [],
      "x-tf-ui": {
        "group": "networking",
        "order": 2,
        "widget": "list-of-strings"
      }
    },
    "private_endpoint_network_policies": {
      "type": "string",
      "title": "PE Network Policies",
      "default": "Disabled",
      "enum": [
        "Disabled",
        "Enabled"
      ],
      "x-tf-ui": {
        "group": "networking",
        "order": 3
      }
    }
  },
  "x-tf-checks": [
    {
      "rule": "cidr",
      "field": "address_prefixes"
    },
    {
      "rule": "cidr_within_parent",
      "field": "address_prefixes",
      "parent_field": "address_space"
    },
    {
      "rule": "cidr_no_overlap",
      "field": "address_prefixes"
    }
  ]
}
