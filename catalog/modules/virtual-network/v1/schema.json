{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Azure Virtual Network with subnets.",
  "properties": {
    "address_space": {
      "description": "(Optional) The address space that is used the virtual network. You can supply more than one address space.",
      "items": {
        "type": "string"
      },
      "title": "Address Space",
      "type": "array",
      "x-tf-ui": {
        "group": "networking",
        "order": 1,
        "widget": "cidr-list",
        "cidr": {
          "suggest": [
            16,
            20,
            24
          ]
        }
      }
    },
    "dns_servers": {
      "default": [],
      "description": "List of DNS servers to use for the virtual network.",
      "items": {
        "type": "string"
      },
      "title": "DNS Servers",
      "type": "array",
      "x-tf-ui": {
        "group": "networking",
        "order": 2,
        "widget": "list-of-strings"
      }
    },
    "name": {
      "description": "(Required) The name of the virtual network. Changing this forces a new resource to be created.",
      "title": "VNet Name",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "resource_group_name": {
      "description": "(Required) The name of the resource group in which to create the virtual network. Changing this forces a new resource to be created.",
      "title": "Resource Group",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 2,
        "pick": {
          "module_type": "resource-group",
          "output": "name"
        },
        "widget": "pick-existing"
      }
    },
    "subnets": {
      "description": "List of subnets",
      "items": {
        "properties": {
          "address_prefixes": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "type": "string"
          },
          "route_table_id": {
            "type": "string"
          },
          "security_group": {
            "type": "string"
          }
        },
        "required": [
          "address_prefixes",
          "name"
        ],
        "type": "object"
      },
      "title": "Subnets",
      "type": "array",
      "x-tf-ui": {
        "group": "subnets",
        "order": 1,
        "widget": "nested-map-of-objects"
      }
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "(Optional) A mapping of tags to assign to the resource.",
      "title": "Tags",
      "type": "object",
      "x-tf-ui": {
        "group": "tags",
        "order": 1,
        "widget": "key-value-map"
      }
    }
  },
  "required": [
    "name",
    "resource_group_name",
    "address_space",
    "subnets"
  ],
  "title": "Virtual Network",
  "type": "object",
  "x-tf-canvas": {
    "container": true,
    "domain": "network",
    "parents": [
      "resource-group"
    ]
  },
  "x-tf-link": {
    "offers": [
      {
        "kind": "virtual_network",
        "output": "id"
      }
    ]
  },
  "x-tf-module": {
    "filename": "vnet.tf",
    "icon": "VirtualNetwork",
    "provider": "azurerm",
    "source": "git::https://github.com/Anmewzaa/infrastructure-terraform-modules.git//modules/azure/virtual_network",
    "target_folder": "vnet",
    "version": "v1"
  },
  "x-tf-ui": {
    "groups": [
      {
        "id": "basics",
        "label": "Basics",
        "order": 1
      },
      {
        "id": "networking",
        "label": "Networking",
        "order": 2
      },
      {
        "id": "subnets",
        "label": "Subnets",
        "order": 3
      },
      {
        "id": "tags",
        "label": "Tags",
        "order": 4
      }
    ]
  },
  "x-tf-checks": [
    {
      "rule": "cidr",
      "field": "address_space"
    }
  ]
}
