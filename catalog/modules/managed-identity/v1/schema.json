{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed Identity",
  "description": "User-assigned managed identity.",
  "type": "object",
  "x-tf-module": {
    "source": "git::https://github.com/Anmewzaa/infrastructure-terraform-modules.git//modules/managed-identity",
    "version": "v1",
    "target_folder": "common",
    "filename": "identity.tf",
    "icon": "ManagedIdentity"
  },
  "x-tf-canvas": {
    "parents": [
      "resource-group"
    ],
    "domain": "security"
  },
  "x-tf-ui": {
    "groups": [
      {
        "id": "basics",
        "label": "Basics",
        "order": 1
      },
      {
        "id": "tags",
        "label": "Tags",
        "order": 2
      }
    ]
  },
  "required": [
    "name",
    "resource_group_name",
    "location"
  ],
  "properties": {
    "name": {
      "type": "string",
      "title": "Identity Name",
      "description": "Convention: id-<purpose>.",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "resource_group_name": {
      "type": "string",
      "title": "Resource Group",
      "x-tf-ui": {
        "group": "basics",
        "order": 2,
        "widget": "pick-existing",
        "pick": {
          "module_type": "resource-group",
          "output": "name"
        }
      }
    },
    "location": {
      "type": "string",
      "title": "Location",
      "description": "Azure region.",
      "default": "southeastasia",
      "x-tf-ui": {
        "group": "basics",
        "order": 3
      }
    },
    "tags": {
      "type": "object",
      "title": "Tags",
      "default": {},
      "additionalProperties": {
        "type": "string"
      },
      "x-tf-ui": {
        "group": "tags",
        "order": 1,
        "widget": "key-value-map"
      }
    }
  }
}
