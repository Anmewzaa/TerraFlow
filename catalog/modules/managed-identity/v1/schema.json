{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "User-assigned managed identity.",
  "properties": {
    "name": {
      "description": "(Required) Specifies the name of this User Assigned Identity. Changing this forces a new User Assigned Identity to be created.",
      "title": "Identity Name",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 1
      }
    },
    "resource_group_name": {
      "description": "(Required) Specifies the name of the Resource Group within which this User Assigned Identity should exist. Changing this forces a new User Assigned Identity to be created.",
      "title": "Resource Group",
      "type": "string",
      "x-tf-ui": {
        "group": "basics",
        "order": 2,
        "pick": {
          "module_type": "resource-group",
          "output": "name"
        },
        "widget": "pick-existing"
      }
    },
    "tags": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "description": "(Optional) A mapping of tags to assign to the resource.",
      "title": "Tags",
      "type": "object",
      "x-tf-ui": {
        "group": "tags",
        "order": 1,
        "widget": "key-value-map"
      }
    }
  },
  "required": [
    "name",
    "resource_group_name"
  ],
  "title": "Managed Identity",
  "type": "object",
  "x-tf-canvas": {
    "domain": "security",
    "parents": [
      "resource-group"
    ]
  },
  "x-tf-module": {
    "filename": "identity.tf",
    "icon": "ManagedIdentity",
    "provider": "azurerm",
    "source": "git::https://github.com/Anmewzaa/infrastructure-terraform-modules.git//modules/azure/user_assigned_identity",
    "target_folder": "common",
    "version": "v1"
  },
  "x-tf-ui": {
    "groups": [
      {
        "id": "basics",
        "label": "Basics",
        "order": 1
      },
      {
        "id": "tags",
        "label": "Tags",
        "order": 2
      }
    ]
  }
}
